{
  "expo": {
    "name": "BudgetFriendly",
    "slug": "mobile",
    "scheme": "budgetfriendly",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSFaceIDUsageDescription": "BudgetFriendly uses Face ID so you can unlock your account without typing your password."
      },
      "bundleIdentifier": "com.budgetfriendly.app",
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.budgetfriendly.app"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0D2B26"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.budgetfriendly.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/logo.png",
          "resizeMode": "contain",
          "backgroundColor": "#0D2B26"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "BudgetFriendly uses Face ID so you can unlock your account without typing your password."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#1C6B5E"
        }
      ],
      "@bacons/apple-targets",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "SafeToSpend",
              "label": "Safe to spend",
              "description": "What you can spend today and how your budget is pacing",
              "minWidth": "180dp",
              "minHeight": "110dp",
              "targetCellWidth": 3,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      "expo-font",
      [
        "expo-audio",
        {
          "microphonePermission": "BudgetFriendly uses the microphone so you can talk to Flux and log spending by voice."
        }
      ],
      "expo-asset",
      "expo-sharing"
    ]
  }
}
