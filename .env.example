## Backend env (DO NOT COMMIT REAL SECRETS)

# MongoDB Atlas connection string
# Example format: mongodb+srv://<username>:<password>@<cluster-host>/<db>?retryWrites=true&w=majority
MONGODB_URI=

# Mongo database name (defaults to budgetfriendly if not set)
MONGODB_DB=budgetfriendly

# JWT secrets (generate fresh random values; Base64 is fine)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# minutes
JWT_ACCESS_TTL_MIN=15

# days
JWT_REFRESH_TTL_DAYS=30

# Password reset emails (Resend). Without a key, codes are logged to the server console in dev.
RESEND_API_KEY=
EMAIL_FROM=BudgetFriendly <no-reply@yourdomain.com>
# minutes a reset code stays valid
PASSWORD_RESET_TTL_MIN=15
# Set to 1 ONLY for local testing: returns the reset code in the API response
AUTH_DEV_EXPOSE_RESET_CODE=

# Scheduled job (vercel.json crons). Vercel sends this as a Bearer token; generate a long random value.
CRON_SECRET=
# Calendar-day offset for due dates and reminders, in minutes from UTC (60 = West Africa Time)
APP_TZ_OFFSET_MINUTES=60

# Push notifications via Expo. Optional unless you enable "enhanced push security" in Expo.
EXPO_ACCESS_TOKEN=

# Live bank connections via Mono (https://app.withmono.com). Leave empty to keep the demo bank flow.
MONO_SECRET_KEY=

MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/budgetfriendly?retryWrites=true&w=majority
MONGODB_DB=budgetfriendly

JWT_ACCESS_SECRET=change_me_access
JWT_REFRESH_SECRET=change_me_refresh

# minutes
JWT_ACCESS_TTL_MIN=15
# days
JWT_REFRESH_TTL_DAYS=30
